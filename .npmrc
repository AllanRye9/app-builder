# If a dependency bump (e.g. from `npm audit fix`) ever introduces a peer
# dependency mismatch like vite/@vitejs/plugin-react drifting apart, this
# keeps `npm ci` from hard-failing the Docker build over it. The versions
# in package.json are still pinned exactly on purpose — this is a backstop,
# not a substitute for keeping them in sync.
legacy-peer-deps=true
