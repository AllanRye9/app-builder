# Copy this file to `.env` for local development — server/index.js loads it
# automatically via dotenv. In production, set these as real environment
# variables in your platform's dashboard instead (Render: Environment tab,
# Vercel: Project Settings → Environment Variables, Railway/Fly: their
# equivalents) — .env files are never used there.

# Fine-grained PAT scoped to this repo: Contents (read/write), Actions (read/write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Any random string — must match nowhere else except that it's sent as part
# of the repository_dispatch payload, so no GitHub-side secret is needed for it.
# render.yaml auto-generates this if you deploy via the Render Blueprint.
# If left unset anywhere, the server generates a temporary one at boot so it
# still works — but that value changes on every restart, invalidating any
# build in progress at the time. Set a real value for anything beyond quick
# local testing.
CALLBACK_SECRET=

# Where uploaded zips, built APKs, and job status are stored. Point this at
# a mounted persistent disk (e.g. Render Disk mounted at /data) to survive
# redeploys/restarts. If unset, or if this path isn't writable (e.g. on
# read-only serverless filesystems like Vercel), the server automatically
# falls back to a local/temp directory instead — it still works, it just
# won't persist data between restarts.
DATA_DIR=/data
