# Copy to .env and adjust if needed. docker-compose reads these automatically.

PORT=3000

# Optional tuning, all have sane defaults in src/config.js:
# MAX_CONCURRENT_BUILDS=1
# BUILD_MEMORY_LIMIT=2g
# BUILD_CPU_LIMIT=2
# BUILD_TIMEOUT_MS=900000
# MAX_UPLOAD_BYTES=157286400
# JOB_TTL_MS=3600000

# Set this once the frontend is deployed separately (e.g. on Vercel) from
# this worker — restricts which origin's browser JS may call this API.
# Comma-separate multiple origins. Defaults to '*' (any origin) if unset.
# CORS_ORIGIN=https://your-app.vercel.app
