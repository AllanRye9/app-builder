# Set these in Vercel project settings (Settings → Environment Variables) —
# this file is just a reference for what's needed, not loaded automatically.

# Fine-grained PAT scoped to this repo: Contents (read/write), Actions (read/write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Any random string — must match nowhere else except that it's sent as part
# of the repository_dispatch payload, so no GitHub-side secret is needed for it.
CALLBACK_SECRET=

# Set automatically when you attach a Blob store to this Vercel project
# (Storage tab → Create Database → Blob). Also copy this exact value into
# the repo's GitHub Actions secrets as BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
