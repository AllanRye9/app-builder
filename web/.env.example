# Copy to .env (or .env.production / .env.local per Vite convention) and adjust.

# Leave blank/unset for the default single-origin deployment, where the
# Express server (src/index.js) serves both the built React app and the API
# from the same host (e.g. `docker compose up`, or `npm run build:web && npm start`).
#
# Set this when the frontend is deployed separately from the build worker —
# e.g. this app on Vercel/Netlify/any static host, worker on a VPS/Fly.io/
# Railway/Render (see the root README's "Deploying the frontend separately"
# section for why the worker itself can't run on Vercel).
VITE_API_BASE_URL=https://your-build-worker.example.com
